# Copie para .env.local e preencha. Nunca faça commit de valores reais.

# URL pública do app, sem barra no final. Usada na checagem de Origin (CSRF) e nos links de reset de senha.
# Local: http://localhost:3000 | Produção: https://<app>.<env>.chilecentral.azurecontainerapps.io
APP_URL=http://localhost:3000

# development | test | production (o Next define sozinho em dev/build; declare só se precisar forçar).
NODE_ENV=development

# Opcional. Sem ela o app usa PGlite em .data/pglite (ou PGLITE_DIR).
# Azure Database for PostgreSQL exige TLS: termine a URL com ?sslmode=verify-full
# ATENÇÃO: apontar para o banco de produção faz o `npm run dev` gravar dados reais.
# DATABASE_URL=postgres://usuario:senha@host:5432/codeforge?sslmode=verify-full
# PGLITE_DIR=.data/pglite

# Cadastro (POST /api/auth/register). Os dados de estudo ainda não são separados por usuário,
# então em produção deixe fechado e libere só e-mails específicos.
# REGISTRATION_OPEN=false
# REGISTRATION_ALLOWLIST=voce@exemplo.com,outra@exemplo.com

# Tutor de IA (rota /api/ai/tutor).
ANTHROPIC_API_KEY=

# Execução de código (Judge0), opcional.
# JUDGE0_URL=
# JUDGE0_TOKEN=

# Fuso usado para "dia de estudo" (sequência e mapa de calor).
# TZ_STUDY=America/Sao_Paulo
